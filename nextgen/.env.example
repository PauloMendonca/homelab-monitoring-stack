# notify-api / notify-mcp — local development .env.example
# ============================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: This file contains PLACEHOLDERS ONLY.
# No real secrets, tokens, or user IDs are in this file.
# In production (MicroK8s), all secrets are injected via K8s Secrets
# provisioned from 1Password by apply_all_k8s_secrets.sh — never committed to git.
#
# Variables are sorted alphabetically within each section.
# ============================================================

# ----------------------------------------------------------------
# External access (for Hermes/MaxHermes outside the cluster)
# ----------------------------------------------------------------
# Primary URL for external Hermes/MaxHermes callers:
#   https://<notify-paulo-hostname>/tools/notify-paulo
# Cloudflare Tunnel origin:
#   http://notify-api.ai-platform.svc.cluster.local:8080
# Internal K8s alternative (for pods inside ai-platform):
#   http://notify-api.ai-platform.svc.cluster.local:8080/tools/notify-paulo
# Bearer auth is always mandatory at the backend, regardless of access path.

# ----------------------------------------------------------------
# notify-api — notify_paulo (Slack DM)
# ----------------------------------------------------------------
# Bearer auth key for /tools/notify-paulo.
# Hermes/MaxHermes use this as the Bearer token.
# Replace with a random 32+ character string for local dev.
NOTIFY_TOOL_API_KEY=replace-with-notify-tool-api-key

# Slack Bot User OAuth Token (xoxb-...).
# Set to "xoxb-test-placeholder" for dry-run mode (no real Slack call).
SLACK_BOT_TOKEN=xoxb-test-placeholder

# Your Slack User ID (U...), e.g. U01XXXXXXXX.
# Used as the DM destination — never configurable by callers.
SLACK_PAULO_USER_ID=UXXXXXXXXX

# ----------------------------------------------------------------
# notify-api — Redis (shared with notify-worker)
# ----------------------------------------------------------------
REDIS_HOST=redis-notify
REDIS_PASSWORD=
REDIS_STREAM_DLQ=notify:dlq
REDIS_STREAM_MESSAGES=notify:messages
REDIS_STREAM_STATUS=notify:status
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------
# notify-api — legacy WhatsApp /v1/messages (not used by notify_paulo)
# ----------------------------------------------------------------
# Optional API key for legacy WhatsApp endpoints.
# If unset, /v1/messages accepts requests without auth (legacy fail-open).
# NOTIFY_API_KEY=replace-with-notify-api-key

# ----------------------------------------------------------------
# notify-api — Evolution API (WhatsApp worker)
# ----------------------------------------------------------------
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=homelab

# ----------------------------------------------------------------
# notify-api — operational
# ----------------------------------------------------------------
# How many days to keep message status records in Redis.
STATUS_RETENTION_DAYS=30
# How many times notify-worker retries a failed message before DLQ.
MAX_RETRIES=5

# ----------------------------------------------------------------
# notify-mcp — MCP server
# ----------------------------------------------------------------
# Host/port the MCP HTTP server listens on.
MCP_HOST=0.0.0.0
MCP_PORT=8000
# notify-api base URL (for WhatsApp tools — not used for notify_paulo).
NOTIFY_API_URL=http://localhost:8080
# Auth key for /v1/messages (optional, matches NOTIFY_API_KEY above).
# NOTIFY_API_KEY=replace-with-notify-api-key
# Bearer key for /tools/notify-paulo (matches NOTIFY_TOOL_API_KEY above).
# NOTIFY_TOOL_API_KEY=replace-with-notify-tool-api-key
